table inet vpn_service {
  set admin_sources { type ipv4_addr; flags interval; elements = { {{ admin_cidrs | join(', ') }} } }
  set forbidden_v4 { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 } }
  counter input_drops { }
  counter forward_drops { }
  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state invalid drop
    # Gate client traffic BEFORE established state to keep administrative networks isolated.
    iifname "vpn0" ip saddr {{ vpn_network }} ip daddr {{ vpn_address }} udp dport 53 accept
    iifname "vpn0" ip saddr {{ vpn_network }} ip daddr {{ vpn_address }} tcp dport 53 accept
    iifname "vpn0" ip saddr {{ vpn_network }} ip daddr {{ vpn_address }} icmp type echo-request limit rate 10/second accept
    iifname "vpn0" counter name input_drops drop
    ct state established,related accept
    ip protocol icmp accept
    meta l4proto ipv6-icmp accept
    ip saddr @admin_sources tcp dport 22 ct state new accept
    iifname "{{ ansible_facts.default_ipv4.interface }}" udp dport {{ vpn_port }} accept
    iifname "{{ ansible_facts.default_ipv4.interface }}" ip saddr {{ mgmt_peer_endpoint }} udp dport 51821 accept
    iifname "wg-mgmt" ip saddr {{ mgmt_peer_address }} tcp dport 8443 accept
    # Preserve DHCP renewal on provider-managed public interfaces.
    iifname "{{ ansible_facts.default_ipv4.interface }}" udp sport 67 udp dport 68 accept
    counter name input_drops drop
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state invalid drop
    iifname "vpn0" ip daddr @forbidden_v4 counter name forward_drops drop
    # NAT would otherwise make a client appear to be this host at the peer's management port.
    iifname "vpn0" ip daddr {{ mgmt_peer_endpoint }} udp dport 51821 counter name forward_drops drop
    # IPv6 user traffic is captured by the tunnel and intentionally rejected; never bypassed.
    iifname "vpn0" meta nfproto ipv6 counter name forward_drops reject with icmpv6 type admin-prohibited
    iifname "vpn0" oifname "{{ ansible_facts.default_ipv4.interface }}" ip saddr {{ vpn_network }} accept
    iifname "{{ ansible_facts.default_ipv4.interface }}" oifname "vpn0" ip daddr {{ vpn_network }} ct state established,related accept
    counter name forward_drops drop
  }
}
table ip vpn_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "{{ ansible_facts.default_ipv4.interface }}" ip saddr {{ vpn_network }} masquerade
  }
}

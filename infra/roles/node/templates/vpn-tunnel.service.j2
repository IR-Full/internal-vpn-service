[Unit]
Description=Private VPN tunnel and peer reconciliation
After=network-online.target vpn-firewall.service
Wants=network-online.target
Requires=vpn-firewall.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vpn-node-apply /etc/vpn-service/tunnel.json
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/vpn-service /var/lib/vpn-service /var/log/vpn-service

[Install]
WantedBy=multi-user.target

server {
    listen 10.78.0.2:8443 ssl;
    server_name _;
    ssl_certificate /etc/vpn-service/telemetry-cert.pem;
    ssl_certificate_key /etc/vpn-service/telemetry-key.pem;
    ssl_client_certificate /etc/vpn-service/telemetry-ca.pem;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4m;
    client_body_timeout 10s;
    access_log off;
    error_log /var/log/nginx/vpn-telemetry-error.log warn;
    location = /api/v1/write {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:9090;
    }
    location = /loki/api/v1/push {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:3100;
    }
    location = /healthz { return 200 'ok'; }
    location / { return 404; }
}
